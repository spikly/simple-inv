<?php
/**
 * The dashboard: totals across the top, then whatever wants attention.
 *
 * @var array $totals        Counts from fetchDashboardTotals().
 * @var array $lowStock      Parts at or below their reorder level.
 * @var array $overCommitted Parts with more reserved than held.
 * @var array $toolsOut      Tools that are signed out.
 * @var int   $overdue       How many of those are late back.
 * @var array $openProjects  Projects still being worked on.
 * @var array $recent        The last few items added.
 * @var int   $rowLimit      How many rows a section shows.
 */

/** The first $rowLimit of a list, noting anything left off the end. */
$topOf = static function (array $rows) use ($rowLimit) {
    $hidden = count($rows) - $rowLimit;

    if ($hidden > 0) {
        echo '<p>Showing the first ' . $rowLimit . ', with ' . $hidden . ' more not listed.</p>' . "\n";
    }

    return array_slice($rows, 0, $rowLimit);
};

/** Shared renderer for the two stock warning tables. */
$stockTable = static function (array $items) {
    renderTable(
        ['Item', 'Location', 'Held', 'Free', 'Reorder At', 'Supplier', ''],
        $items,
        static function ($item) {
            return [
                '<a href="index.php?page=view-item&item_id=' . $item['item_id'] . '">'
                    . escapeHtml($item['item_name']) . '</a>',
                locationCell($item),
                escapeHtml($item['item_quantity']) . escapeHtml($item['unit_symbol']),
                stockCell($item),
                (int)$item['item_min_quantity'] > 0 ? escapeHtml($item['item_min_quantity']) : '-',
                escapeHtml($item['sup_name'] ?? ''),
                            '<a href="index.php?page=adjust-stock&item_id=' . $item['item_id'] . '">Add Stock</a>',
            ];
        }
    );
};

pageHeader('Dashboard', [
    'Add Part'    => 'index.php?page=add-item&kind=part',
    'Add Tool'    => 'index.php?page=add-item&kind=tool',
    'Add Project' => 'index.php?page=add-project',
]);

formMessage(takeFlash());
?>
<div class="item-property-container">
<?php
itemProperty('Parts', '<p><a href="index.php?page=parts">' . (int)$totals['part_count'] . '</a></p>');
itemProperty('Total Quantity', '<p>' . formatQuantity($totals['total_quantity']) . '</p>');
itemProperty('Tools', '<p><a href="index.php?page=tools">' . (int)$totals['tool_count'] . '</a></p>');
itemProperty(
    'Tools Out',
    '<p>' . count($toolsOut) . '</p>',
    $overdue > 0 ? 'red' : ($toolsOut ? 'amber' : 'green')
);
itemProperty('Open Projects', '<p><a href="index.php?page=projects">'
    . (int)$totals['open_project_count'] . '</a></p>');
itemProperty('Low Stock', '<p>' . count($lowStock) . '</p>', $lowStock ? 'amber' : 'green');
itemProperty('Over Committed', '<p>' . count($overCommitted) . '</p>', $overCommitted ? 'red' : 'green');
?>
</div>

<?php sectionHeader('Low Stock'); ?>
<?php if ($lowStock): ?>
    <?php $stockTable($topOf($lowStock)); ?>
<?php else: ?>
<p>Nothing is at its reorder level.</p>
<?php endif; ?>

<?php if ($overCommitted): ?>
    <?php sectionHeader('Over Committed'); ?>
<p>More of these are reserved for projects than actually held in stock.</p>
    <?php $stockTable($topOf($overCommitted)); ?>
<?php endif; ?>

<?php sectionHeader('Tools Out', ['All Tools' => 'index.php?page=tools']); ?>
<?php if ($toolsOut): ?>
<?php
renderTable(
    ['Tool', 'Signed Out To', 'Out Since', 'Due Back', 'Kept In'],
    $topOf($toolsOut),
    static function ($loan) {
        $late = loanIsOverdue($loan['loan_due_at']);

        return [
            '<a href="index.php?page=view-item&item_id=' . (int)$loan['loan_item_id'] . '">'
                . escapeHtml($loan['item_name']) . '</a>',
            escapeHtml($loan['loan_to']),
            escapeHtml(formatDate($loan['loan_out_at'])),
            $loan['loan_due_at']
                ? '<span class="stock ' . ($late ? 'stock-over' : 'stock-ok') . '">'
                    . escapeHtml(formatDate($loan['loan_due_at'])) . '</span>'
                : '-',
            locationCell($loan),
        ];
    }
);
?>
<?php else: ?>
<p>Every tool is where it should be.</p>
<?php endif; ?>

<?php sectionHeader('Open Projects', ['All Projects' => 'index.php?page=projects']); ?>
<?php if ($openProjects): ?>
<?php
renderTable(
    ['Project', 'Status', 'Assemblies', 'Required', 'Installed', 'Progress'],
    $topOf($openProjects),
    static function ($project) {
        $required = (float)$project['required_quantity'];
        $installed = (float)$project['installed_quantity'];

        return [
            '<a href="index.php?page=view-project&project_id=' . (int)$project['project_id'] . '">'
                . escapeHtml($project['project_name']) . '</a>',
            escapeHtml($project['project_status_name']),
            (int)$project['assembly_count'],
            formatQuantity($required),
            formatQuantity($installed),
            ($required > 0 ? min(100, round(($installed / $required) * 100)) : 0) . '%',
        ];
    }
);
?>
<?php else: ?>
<p>No projects are open.</p>
<?php endif; ?>

<?php sectionHeader('Recently Added'); ?>
<?php if ($recent): ?>
<?php
renderTable(
    ['', 'Item', 'Type', 'Location', 'Status', 'Added'],
    $recent,
    static function ($item) {
        return [
            itemThumb($item['item_image'], $item['item_name']),
            '<a href="index.php?page=view-item&item_id=' . $item['item_id'] . '">'
                . escapeHtml($item['item_name']) . '</a>',
            ITEM_TYPES[itemTypeOf($item)],
            locationCell($item),
            escapeHtml($item['status_name'] ?? ''),
            escapeHtml(formatDate($item['item_created_at'])),
        ];
    },
    [0 => 'col-thumb']
);
?>
<?php else: ?>
<p>Nothing yet. <a href="index.php?page=add-item">Add your first part.</a></p>
<?php endif; ?>
