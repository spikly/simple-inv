<?php
/**
 * @var array   $tax         Its definition.
 * @var mixed   $row         Stored row, or false if not found.
 * @var array   $values      The row, or what a rejected save submitted.
 * @var mixed   $formMessage Last result, or false.
 * @var string  $indexUrl
 * @var mixed   $editId
 * @var int     $inUse       Items using this row; blocks deletion.
 * @var ?string $blocker     Any other reason it cannot be deleted, eg sub-locations.
 */

pageHeader('Edit ' . $tax['label'], ['Back to ' . $tax['plural'] => $indexUrl]);

if (!$row):
    formMessage($formMessage); ?>
<p>No <?php echo strtolower($tax['label']); ?> found</p>
<?php
    return;
endif;

if (isset($tax['notice'])) {
    $tax['notice']($row);
}

taxonomyForm($tax, 'edit', $values, $formMessage, [], $editId);

if ($inUse > 0):
    sectionHeader('Delete ' . $tax['label']); ?>
<p>
    This <?php echo strtolower($tax['label']); ?> is used by
    <a href="index.php?page=items&<?php echo $tax['param'] . '=' . (int)$editId; ?>"><?php
        echo $inUse . ' ' . ($inUse === 1 ? 'item' : 'items');
    ?></a>. Move <?php echo $inUse === 1 ? 'it' : 'them'; ?> elsewhere before deleting.
</p>
<?php
    return;
endif;

if ($blocker !== null):
    sectionHeader('Delete ' . $tax['label']); ?>
<p><?php echo escapeHtml($blocker); ?></p>
<?php
    return;
endif;

deleteSection(
    $tax['label'],
    'delete_' . $tax['submit'] . '_submit',
    'Delete',
    'Delete this ' . strtolower($tax['label']) . '?'
);
