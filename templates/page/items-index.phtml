<?php
/**
 * @var ?string $type    Kind the page is pinned to, or null for the mixed listing.
 * @var array   $items   Rows on this page.
 * @var array   $slice   From paginate().
 * @var array   $applied Taxonomy filters in force.
 * @var string  $noun
 * @var string  $badges  Raw HTML filter badges for the heading.
 * @var array   $links   Heading links, label => href.
 * @var array   $columns Heading => function giving that heading's cell.
 * @var mixed   $formMessage
 * @var array   $bulk    See item/bulk-bar.
 */

pageHeader($noun . countBadge($slice['total'], $badges), $links);

formMessage($formMessage);
renderItemFilters($applied, $type, itemTypePage($type));

if (!$items): ?>
<p>No <?php echo strtolower($noun); ?> match.</p>
<?php
    return;
endif;

renderItemTable($items, $columns);

template('item/bulk-bar', $bulk + [
    'noun'  => strtolower($noun),
    'total' => $slice['total'],
]);

renderPagination($slice, strtolower($noun));
