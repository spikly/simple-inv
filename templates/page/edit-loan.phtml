<?php
/**
 * @var mixed $loan        The record, or false if not found.
 * @var array $values      The fields, as stored or as last entered.
 * @var mixed $itemId      The tool, for the link back.
 * @var mixed $formMessage Last result, or false.
 */

pageHeader('Edit Sign-Out Record', $itemId ? [
    'View Tool' => 'index.php?page=view-item&item_id=' . urlencode((string)$itemId),
] : []);

if (!$loan):
    formMessage($formMessage); ?>
<p>No sign-out record found</p>
<?php
    return;
endif;
?>
<form method="post">
<?php
formMessage($formMessage);

textField('loan_to', 'Signed Out To', $values['loan_to'], 'text', ' required');
textField('loan_due_at', 'Due Back (optional)', $values['loan_due_at'], 'date');
textField('loan_in_at', 'Returned (clear this to put it back out)', $values['loan_in_at'], 'datetime-local');
textareaField('loan_notes', 'Notes (optional)', $values['loan_notes']);
submitButton('edit_loan_submit');
?>
</form>
<?php
deleteSection(
    'Sign-Out Record',
    'delete_loan_submit',
    'Delete',
    'Delete this sign-out record? The tool\'s history loses it for good.'
);
