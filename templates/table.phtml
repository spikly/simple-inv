<?php
/**
 * Headings and cells are raw HTML. Sorting is done in assets/js/app.js.
 *
 * @var array    $headings
 * @var array    $items
 * @var callable $rows          Takes one item, returns its cells.
 * @var array    $columnClasses Column index => class, on th and td alike.
 */

$cells = static function (array $values, string $tag) use ($columnClasses) {
    $html = '';

    foreach (array_values($values) as $index => $value) {
        $class = isset($columnClasses[$index]) ? ' class="' . $columnClasses[$index] . '"' : '';
        $html .= '<' . $tag . $class . '>' . $value . '</' . $tag . '>';
    }

    return $html;
};
?>
<div class="table-container">
    <table class="sortable">
        <tr><?php echo $cells($headings, 'th'); ?></tr>
<?php foreach ($items as $item): ?>
        <tr><?php echo $cells($rows($item), 'td'); ?></tr>
<?php endforeach; ?>
    </table>
</div>
