<?php
/**
 * @var string $key      Taxonomy key, eg 'brand'.
 * @var array  $tax      Its definition.
 * @var string $name     Field name, also the select's id.
 * @var string $type     'part' or 'tool'.
 * @var bool   $multiple
 * @var array  $options  value => label.
 * @var mixed  $selected
 */
?>
<div class="searchable-select-row"><div class="searchable-select-slot"><select name="<?php
    echo $name . ($multiple ? '[]' : '');
?>" id="<?php echo $name; ?>" data-item-type="<?php echo $type; ?>"<?php
    echo invalidAttributes($name);
    echo $multiple ? ' multiple data-placeholder="Select..."' : '';
?>><?php
    echo $multiple ? '' : '<option value="0">Select</option>';
    echo selectOptions($options, $selected);
?></select></div><button type="button" class="add-new-attribute-value" id="add_new_<?php
    echo $key;
?>" data-item-type="<?php echo $type; ?>" title="Add new <?php
    echo $tax['label'];
?>">+</button></div>
