<?php
/**
 * A redirect made out of markup, for the case where the headers have already
 * gone out and there is nothing else left to send the browser on with.
 *
 * @var string $url Where to go.
 */
?>
<meta http-equiv="refresh" content="0;url=<?php echo escapeHtml($url); ?>">
<p><a href="<?php echo escapeHtml($url); ?>">Continue</a></p>
