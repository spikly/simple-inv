<?php
/**
 * A <div>, not a <p>: a block-level control would close the <p> early and lose
 * the invalid mark.
 *
 * @var string $name       Also the control's id.
 * @var string $label      Raw HTML.
 * @var string $control    Raw HTML.
 * @var bool   $hasControl False for a read-only row, so the label gets no for="".
 * @var string $error      Rejection reason, or ''.
 */
?>
<?php if ($error === ''): ?>
    <div class="form-row">
<?php else: ?>
    <div class="form-row field-invalid" data-field="<?php echo $name; ?>">
<?php endif; ?>
        <label<?php echo $hasControl ? ' for="' . $name . '"' : ''; ?>><?php echo $label; ?></label>
        <?php echo $control; ?>
<?php if ($error !== ''): ?>
        <span class="field-error" id="<?php echo $name; ?>_error"><?php echo $error; ?></span>
<?php endif; ?>
    </div>
