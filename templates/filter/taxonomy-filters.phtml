<?php
/**
 * A name search, plus the taxonomy's own dropdown if it has one (only categories do).
 *
 * @var string $page
 * @var string $placeholder
 * @var string $search
 * @var ?array $filter      The taxonomy's own filter, or null.
 * @var string $value       Its current value, or ''.
 */
?>
<form method="get" class="filter-bar">
    <input type="hidden" name="page" value="<?php echo $page; ?>">
<?php
filterField(
    'q',
    'Search',
    '<input type="search" name="q" id="q" value="' . escapeHtml($search)
        . '" placeholder="' . escapeHtml($placeholder) . '">',
    'filter-search'
);

if ($filter) {
    $id = 'filter_' . $filter['param'];

    // "Any ..." doubles as the label; the bar has no headings.
    filterField(
        $id,
        $filter['label'],
        '<select name="' . $filter['param'] . '" id="' . $id . '">'
            . '<option value="">' . escapeHtml($filter['any']) . '</option>'
            . selectOptions($filter['options'], $value)
            . '</select>'
    );
}

filterActions($page, $search !== '' || $value !== '', $filter ? 'Filter' : 'Search');
?>
</form>
