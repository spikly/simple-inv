<?php
/**
 * The label is for screen readers; sighted users get the placeholder instead.
 *
 * @var string $id
 * @var string $label
 * @var string $control Raw HTML.
 * @var string $class   Extra wrapper class.
 */
?>
    <p class="filter-field<?php echo $class ? ' ' . $class : ''; ?>">
        <label for="<?php echo $id; ?>" class="visually-hidden"><?php echo $label; ?></label>
        <?php echo $control; ?>
    </p>
