<?php
/**
 * One dropdown per taxonomy plus a search, combined with AND.
 *
 * @var string  $page
 * @var string  $search
 * @var ?string $kind       Kind the page is pinned to, or null for the mixed listing.
 * @var bool    $inCategory A chosen category already fixes the kind.
 * @var bool    $hasFilters Whether to offer Clear.
 */
?>
<form method="get" class="filter-bar" data-collapsible>
    <input type="hidden" name="page" value="<?php echo $page; ?>">
<?php
filterField(
    'q',
    'Search',
    '<input type="search" name="q" id="q" value="' . escapeHtml($search)
        . '" placeholder="Search name, part number or notes">',
    'filter-search'
);

// Dropdowns already in use, shown on the mobile toggle while they're hidden.
// The kind counts only when it has a dropdown of its own below.
$showKind = ($kind === null && !$inCategory);
$active = count(array_filter(
    array_merge($showKind ? ['kind'] : [], array_column(taxonomies(), 'param')),
    fn($param) => (string)queryParam($param) !== ''
));
?>
    <button type="button" class="filter-toggle" aria-expanded="false" hidden>
        Filters<?php if ($active): ?> (<?php echo $active; ?>)<?php endif; ?>
    </button>
<?php

if ($showKind) {
    filterField(
        'filter_kind',
        'Type',
        '<select name="kind" id="filter_kind">'
            . '<option value="">Any Type</option>'
            . selectOptions(ITEM_TYPES, queryParam('kind'))
            . '</select>',
        'filter-option'
    );
}

foreach (taxonomies() as $key => $tax) {
    $id = 'filter_' . $tax['param'];

    // On a listing pinned to one kind, the other kind's categories match nothing.
    $options = ($key === 'category' && $kind !== null)
        ? categoryOptions($kind)
        : taxonomyOptions($key);

    // "Any ..." doubles as the label; the bar has no headings.
    filterField(
        $id,
        $tax['label'],
        '<select name="' . $tax['param'] . '" id="' . $id . '">'
            . '<option value="">Any ' . $tax['label'] . '</option>'
            . selectOptions($options, queryParam($tax['param']))
            . '</select>',
        'filter-option'
    );
}

filterActions($page, $hasFilters);
?>
</form>
