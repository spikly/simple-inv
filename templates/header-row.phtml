<?php
/**
 * A heading and the links that belong with it.
 *
 * $title and $extraHtml are raw HTML so a caller can add a count badge or a
 * small form; anything typed by a person has to be escaped before it gets here.
 *
 * @var string $class     Wrapper class, which is what sets the spacing.
 * @var string $title     Heading HTML.
 * @var array  $links     label => href.
 * @var string $extraHtml Appended inside the nav.
 */
?>
<div class="<?php echo $class; ?>">
    <h2><?php echo $title; ?></h2>
<?php if ($links || $extraHtml): ?>
    <nav class="onpage-nav">
<?php foreach ($links as $label => $href): ?>
        <a href="<?php echo $href; ?>"><?php echo $label; ?></a>
<?php endforeach; ?>
<?php echo $extraHtml; ?>
    </nav>
<?php endif; ?>
</div>
